# ============================================================
# ICON — environment template
# ------------------------------------------------------------
# Copy this file to `.env`, fill in the two values, then run:
#
#     npm run config
#
# That generates `config.js`, which the HTML pages load.
# `.env` and `config.js` are both gitignored — never commit them.
#
# On Vercel/Netlify you do NOT need a .env file: set these same
# names in the hosting dashboard instead. The build script reads
# real environment variables first.
# ============================================================


# ---------- REQUIRED: these two, and nothing else -----------

# Your Supabase project URL.
# Where: Supabase Dashboard -> your project -> Settings -> Data API
#        -> "Project URL"
# Looks like: https://abcdefghijklmnop.supabase.co
SUPABASE_URL=

# Your Supabase publishable (anon) key.
# Where: Supabase Dashboard -> your project -> Settings -> API Keys
#        -> "Publishable key"   (older projects: "anon public")
# This key is SAFE in frontend code. Row Level Security and the
# database functions protect your data, not the secrecy of this key.
# Looks like: sb_publishable_xxxxxxxxxxxxxxxxxxxxx
#         or: eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_KEY=


# ---------- There is no third key --------------------------
# Staff login does NOT use an API key. Staff IDs and passwords live
# in the `admins` table, created by schema.sql section 9, and are
# verified inside Postgres. Nothing to configure here.
#
# Supabase also issues a "secret" / "service_role" key. It bypasses
# all security and must never reach a browser. Do NOT add it here.


# ---------- OPTIONAL: salon settings ------------------------

# Which row in the `salons` table this install represents.
SALON_ID=1

# Average minutes one haircut takes. Drives the wait estimate.
MINUTES_PER_CLIENT=15

# How many stylist chairs are running. The estimate divides by this,
# so 6 people waiting across 3 chairs = 2 rounds = 30 minutes.
ACTIVE_CHAIRS=1
